{
  "name": "dimah-s3-vite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file=.env server/index.ts",
    "preview": "vite preview",
    "check-types": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@base-ui/react": "^1.7.0",
    "@dimah-s3/react": "^0.8.5",
    "@dimah-s3/server": "^0.8.5",
    "@dimah-s3/ui": "^0.8.5",
    "@fuma-translate/react": "^1.0.2",
    "@hono/node-server": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "hono": "^4.13.3",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
