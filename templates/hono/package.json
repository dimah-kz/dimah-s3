{
  "name": "dimah-s3-hono",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:api": "tsx watch --env-file=.env src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file=.env src/server.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@base-ui/react": "^1.7.0",
    "@dimah-s3/react": "^0.7.1",
    "@dimah-s3/server": "^0.7.1",
    "@dimah-s3/ui": "^0.7.1",
    "@fuma-translate/react": "^1.0.2",
    "@hono/node-server": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
