{
  "name": "dimah-s3-hono",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "concurrently -k -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:api": "tsx watch --env-file=.env src/server.ts",
    "dev:web": "vite",
    "start": "tsx --env-file=.env src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@base-ui/react": "^1.9.0",
    "@dimah-s3/react": "^1.7.0",
    "@dimah-s3/server": "^1.7.0",
    "@dimah-s3/ui": "^1.7.0",
    "@fuma-translate/react": "^1.0.2",
    "@hono/node-server": "^2.1.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
