{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "paths": {
      "@/registry/*": ["./generated/*"],
      "@/*": ["../packages/ui/src/*"]
    },
    "types": ["node"]
  },
  "include": ["items/**/*", "scripts/**/*", "generated/**/*"]
}
