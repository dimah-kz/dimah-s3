# -----------------------------------------------------------------------------
# Docs site — environment variables
# -----------------------------------------------------------------------------
#
# Production (VERCEL_ENV=production) always uses https://s3.dimah.dev.
# NEXT_PUBLIC_SITE_URL is ignored there so a stale dashboard value cannot
# rewrite canonicals, sitemap, or JSON-LD.
# Set it only for preview / local tunnel overrides.
#
# Dashboard: Project → Settings → Environment Variables
#   NEXT_PUBLIC_SITE_URL → optional override → https://s3.dimah.dev
#
# Auto-injected by Vercel (do not copy into .env.local):
#   VERCEL_URL
#   VERCEL_ENV                    production | preview | development
#
# Local dev (optional):
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
