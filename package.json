{
  "name": "dimah-s3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!./examples/* --filter=!brand",
    "build:all": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "check-types": "turbo run check-types",
    "clean:build": "pnpm clean:next && pnpm clean:turbo",
    "clean:next": "node ./scripts/clean-next-artifacts.mjs",
    "clean:turbo": "turbo daemon clean",
    "deps:update": "pnpm -r update --latest && pnpm templates:update",
    "dev": "turbo run dev",
    "examples:drift": "node ./scripts/examples-drift.mjs",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0 scripts eslint.config.js prettier.config.mjs && turbo run lint",
    "registry:build": "pnpm --filter @dimah-s3/ui registry:build",
    "registry:validate": "pnpm --filter @dimah-s3/ui registry:validate",
    "sherif": "sherif",
    "tegami": "node ./scripts/tegami.mts",
    "templates:build": "node ./scripts/templates-build.mjs",
    "templates:update": "node ./scripts/templates-update.mjs",
    "test": "turbo run test --filter=\"./packages/*\"",
    "ui:sync:shadcn": "pnpm --filter @dimah-s3/ui sync:shadcn"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "sherif": "catalog:",
    "tailwindcss": "catalog:",
    "tegami": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
