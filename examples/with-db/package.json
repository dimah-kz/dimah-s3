{
  "name": "@dimah-s3/example-with-db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "db:schema": "node --import tsx scripts/db-cli.mts generate latest -o ./db/dimah-s3.ts",
    "db:push": "drizzle-kit push",
    "db:cli": "node --import tsx scripts/db-cli.mts",
    "db:purge-stale": "node --import tsx --env-file-if-exists=.env scripts/purge-stale-pending.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@base-ui/react": "^1.7.0",
    "@dimah-s3/core": "workspace:*",
    "@dimah-s3/db": "workspace:*",
    "@dimah-s3/react": "workspace:*",
    "@dimah-s3/server": "workspace:*",
    "@dimah-s3/ui": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "fumadb": "^0.5.1",
    "lucide-react": "^1.28.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "catalog:"
  }
}
