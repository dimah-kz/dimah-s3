{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"],
      "fumadb/cuid": ["./node_modules/@paralleldrive/cuid2"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
