{
  "name": "@dimah-s3/example-with-hono",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:api": "tsx watch --env-file=.env src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file=.env src/server.ts",
    "lint": "eslint",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@base-ui/react": "^1.7.0",
    "@dimah-s3/react": "workspace:*",
    "@dimah-s3/server": "workspace:*",
    "@dimah-s3/ui": "workspace:*",
    "@fuma-translate/react": "^1.0.2",
    "@hono/node-server": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "hono": "^4.13.0",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^10.0.4",
    "eslint": "catalog:",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typescript": "catalog:",
    "vite": "^8.2.1"
  }
