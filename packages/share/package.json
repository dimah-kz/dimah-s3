{
  "name": "@dimah-s3/share",
  "version": "2.0.2",
  "description": "Share links for dimah-s3 — expiring, password-protected, revocable links to files and folders",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "share-link",
    "file-sharing",
    "public-link",
    "expiring-link",
    "password-protected",
    "download-limit",
    "object-storage",
    "drizzle",
    "prisma",
    "fumadb",
    "typescript"
  ],
  "homepage": "https://s3.dimah.dev/docs/share",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/share"
  },
  "funding": "https://github.com/sponsors/dimah-kz",
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias && node ../../tooling/tsup-config/dts-extensions.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-s3/core": "workspace:*",
    "fumadb": "~0.7.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@dimah-s3/db": "workspace:*",
    "@dimah-s3/react": "workspace:*",
    "@dimah-s3/server": "workspace:*",
    "@electric-sql/pglite": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "eslint": "catalog:",
    "kysely": "^0.29.9",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dimah-s3/db": "2.0.2",
    "@dimah-s3/server": "2.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
