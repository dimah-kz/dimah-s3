{
  "name": "@dimah-s3/core",
  "version": "0.8.0",
  "description": "Shared types and pure helpers for @dimah-s3/react and @dimah-s3/server",
  "keywords": [
    "s3",
    "presigned-url",
    "file-upload",
    "typescript",
    "object-storage"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/core"
  },
  "homepage": "https://dimah-s3.vercel.app/docs/core",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-fetch/fetch": "catalog:",
    "better-call": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
