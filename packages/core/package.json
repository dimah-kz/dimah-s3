{
  "name": "@dimah-s3/core",
  "version": "1.0.1",
  "description": "Typed S3 presign protocol and fetch client shared by @dimah-s3/server and @dimah-s3/react",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "cloudflare-r2",
    "minio",
    "presigned-url",
    "file-upload",
    "object-storage",
    "typescript"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/core"
  },
  "homepage": "https://dimah-s3.vercel.app/docs/core",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-fetch/fetch": "catalog:",
    "better-call": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "^1.9.2",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
