{
  "name": "@dimah-s3/cli",
  "version": "1.5.9",
  "description": "Scaffold dimah-s3 apps from official templates",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "cloudflare-r2",
    "cli",
    "scaffold",
    "create",
    "starter",
    "template",
    "nextjs",
    "vite",
    "hono",
    "file-upload"
  ],
  "homepage": "https://s3.dimah.dev/docs/quickstart",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "dimah",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "dimah-s3": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/snapshot-templates.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "^0.2.2",
    "nypm": "^0.6.10",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/validate-npm-package-name": "^4.0.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
