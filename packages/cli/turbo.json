{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../templates/**",
        "!../../templates/**/node_modules/**",
        "!../../templates/**/.next/**",
        "!../../templates/**/.turbo/**",
        "!../../templates/**/.source/**",
        "!../../templates/**/.vercel/**",
        "!../../templates/**/dist/**",
        "!../../templates/**/pnpm-lock.yaml",
        "!../../templates/**/package-lock.json",
        "!../../templates/**/yarn.lock",
        "!../../templates/**/*.tsbuildinfo"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
