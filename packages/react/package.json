{
  "name": "@dimah-s3/react",
  "version": "2.2.0",
  "description": "Headless React hooks for presigned S3 file uploads, downloads, and deletes",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "cloudflare-r2",
    "minio",
    "react",
    "react-hooks",
    "nextjs",
    "file-upload",
    "file-uploader",
    "download",
    "uploadthing-alternative",
    "better-upload-alternative",
    "presigned-url",
    "multipart-upload",
    "resumable-upload",
    "dropzone",
    "headless",
    "typescript"
  ],
  "homepage": "https://s3.dimah.dev/docs/react",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/react"
  },
  "funding": "https://github.com/sponsors/dimah-kz",
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm compile:translations && tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias && node ../../tooling/tsup-config/dts-extensions.mjs",
    "check-types": "pnpm compile:translations && tsc --noEmit",
    "compile:translations": "node ./scripts/compile-translations.mjs",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "react-dropzone": "^20.2.1"
  },
  "devDependencies": {
    "@dimah-s3/core": "workspace:*",
    "@fuma-translate/react": "^1.0.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "fuma-translate": "^1.0.2",
    "jsdom": "^31.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dimah-s3/core": "2.2.0",
    "@fuma-translate/react": "^1.0.2",
    "react": "^19.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
