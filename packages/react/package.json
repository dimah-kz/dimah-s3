{
  "name": "@dimah-s3/react",
  "version": "1.5.4",
  "description": "Headless React hooks for presigned S3 file uploads, downloads, and deletes",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "cloudflare-r2",
    "minio",
    "react",
    "react-hooks",
    "nextjs",
    "file-upload",
    "file-uploader",
    "download",
    "uploadthing-alternative",
    "better-upload-alternative",
    "presigned-url",
    "multipart-upload",
    "resumable-upload",
    "dropzone",
    "headless",
    "typescript"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/react"
  },
  "homepage": "https://s3.dimah.dev/docs/react",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile:translations": "node ./scripts/compile-translations.mjs",
    "build": "pnpm compile:translations && tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "lint": "eslint",
    "check-types": "pnpm compile:translations && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-s3/core": "workspace:*",
    "@fuma-translate/react": "^1.0.2",
    "immer": "^11.1.18",
    "react-dropzone": "^20.1.1"
  },
  "peerDependencies": {
    "@fuma-translate/react": "^1.0.2",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "fuma-translate": "^1.0.2",
    "jsdom": "^30.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsc-alias": "^1.9.4",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
