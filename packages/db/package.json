{
  "name": "@dimah-s3/db",
  "version": "1.5.8",
  "description": "Optional database plugin for dimah-s3 — track S3 object ownership, listings, and resumable uploads",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "drizzle",
    "drizzle-orm",
    "object-storage",
    "database",
    "file-upload",
    "resumable-upload",
    "file-tracking",
    "object-tracking",
    "prisma",
    "fumadb",
    "typescript"
  ],
  "homepage": "https://s3.dimah.dev/docs/db",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src/schema/examples"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-s3/core": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "fumadb": "^0.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@dimah-s3/server": "workspace:*",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "eslint": "catalog:",
    "tsc-alias": "^1.9.5",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3",
    "@dimah-s3/server": "1.5.8",
    "drizzle-orm": "^0.44.0 || ^0.45.0 || >=1.0.0-rc.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
