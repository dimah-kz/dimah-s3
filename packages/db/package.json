{
  "name": "@dimah-s3/db",
  "version": "1.7.1",
  "description": "Optional database plugin for dimah-s3 — track S3 object ownership, listings, and resumable uploads",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "drizzle",
    "drizzle-orm",
    "object-storage",
    "database",
    "file-upload",
    "resumable-upload",
    "file-tracking",
    "object-tracking",
    "prisma",
    "fumadb",
    "typescript"
  ],
  "homepage": "https://s3.dimah.dev/docs/db",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite.d.ts",
      "default": "./dist/drizzle/sqlite.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg.d.ts",
      "default": "./dist/drizzle/pg.js"
    },
    "./drizzle/mysql": {
      "types": "./dist/drizzle/mysql.d.ts",
      "default": "./dist/drizzle/mysql.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle.d.ts",
      "default": "./dist/adapters/drizzle.js"
    },
    "./adapters/kysely": {
      "types": "./dist/adapters/kysely.d.ts",
      "default": "./dist/adapters/kysely.js"
    },
    "./adapters/prisma": {
      "types": "./dist/adapters/prisma.d.ts",
      "default": "./dist/adapters/prisma.js"
    }
  },
  "files": [
    "dist",
    "sql",
    "prisma"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-s3/core": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "fumadb": "~0.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@dimah-s3/react": "workspace:*",
    "@dimah-s3/server": "workspace:*",
    "@electric-sql/pglite": "^0.5.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "1.0.0-rc.5",
    "eslint": "catalog:",
    "kysely": "^0.29.7",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3",
    "@dimah-s3/server": "1.7.1",
    "@prisma/client": "^6.0.0 || ^7.0.0",
    "drizzle-orm": ">=1.0.0-rc.5 <2.0.0",
    "kysely": "^0.29.5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
