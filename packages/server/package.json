{
  "name": "@dimah-s3/server",
  "version": "0.7.4",
  "description": "Presigned S3 server — dimahS3() with HTTP handler and direct api for upload, download, delete, and multipart",
  "keywords": [
    "s3",
    "presigned-url",
    "file-upload",
    "cloudflare-r2",
    "aws-s3",
    "minio",
    "nextjs",
    "upload",
    "download",
    "multipart",
    "object-storage",
    "typescript"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/server"
  },
  "homepage": "https://dimah-s3.vercel.app/docs/server",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "default": "./dist/adapters/hono.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "default": "./dist/adapters/fastify.js"
    },
    "./elysia": {
      "types": "./dist/adapters/elysia.d.ts",
      "default": "./dist/adapters/elysia.js"
    },
    "./svelte-kit": {
      "types": "./dist/adapters/svelte-kit.d.ts",
      "default": "./dist/adapters/svelte-kit.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/s3-presigned-post": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@dimah-s3/core": "workspace:*",
    "better-call": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@types/node": "^26.2.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "^1.9.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
