{
  "name": "@dimah-s3/server",
  "version": "2.0.2",
  "description": "Presigned S3 server — dimahS3() with HTTP handler and direct api for upload, download, delete, and multipart",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "cloudflare-r2",
    "minio",
    "presigned-url",
    "presigned-post",
    "file-upload",
    "download",
    "uploadthing-alternative",
    "better-upload-alternative",
    "object-storage",
    "multipart-upload",
    "resumable-upload",
    "nextjs",
    "hono",
    "express",
    "fastify",
    "elysia",
    "sveltekit",
    "typescript"
  ],
  "homepage": "https://s3.dimah.dev/docs/server",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/server"
  },
  "funding": "https://github.com/sponsors/dimah-kz",
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "default": "./dist/adapters/hono.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "default": "./dist/adapters/fastify.js"
    },
    "./elysia": {
      "types": "./dist/adapters/elysia.d.ts",
      "default": "./dist/adapters/elysia.js"
    },
    "./svelte-kit": {
      "types": "./dist/adapters/svelte-kit.d.ts",
      "default": "./dist/adapters/svelte-kit.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias && node ../../tooling/tsup-config/dts-extensions.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/s3-presigned-post": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@dimah-s3/core": "workspace:*",
    "better-call": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
