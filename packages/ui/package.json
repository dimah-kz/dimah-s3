{
  "name": "@dimah-s3/ui",
  "version": "1.4.2",
  "description": "Pre-built React UI components for S3 file upload, download, and delete",
  "keywords": [
    "s3",
    "s3-compatible",
    "aws-s3",
    "cloudflare-r2",
    "react",
    "ui",
    "shadcn",
    "shadcn-ui",
    "file-upload",
    "dropzone",
    "file-uploader",
    "nextjs",
    "components"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-s3.git",
    "directory": "packages/ui"
  },
  "homepage": "https://dimah-s3.vercel.app/docs/react/ui",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-s3/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./css/shadcn.css": "./css/shadcn.css"
  },
  "files": [
    "dist",
    "styles.css",
    "css"
  ],
  "scripts": {
    "build": "pnpm run normalize-imports && tsup --config tsup.config.ts && tsc --emitDeclarationOnly && tsc-alias",
    "sync:shadcn": "node scripts/sync-shadcn.mjs",
    "normalize-imports": "node ./scripts/enforce-src-alias-imports.mjs",
    "registry:items": "tsx scripts/build-registry-items.ts && pnpm -w exec prettier --write packages/ui/registry.json",
    "registry:check": "tsx scripts/check-registry-items.ts",
    "registry:validate": "pnpm registry:items && pnpm registry:check && shadcn registry validate --cwd ../..",
    "registry:build": "pnpm registry:validate && shadcn build --output apps/docs/public/r --cwd ../..",
    "lint": "eslint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.registry.json"
  },
  "dependencies": {
    "@dimah-s3/core": "workspace:*",
    "@dimah-s3/react": "workspace:*",
    "react-file-icon": "^1.6.0"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "@fuma-translate/react": "^1.0.2",
    "class-variance-authority": ">=0.7.0",
    "cnfast": ">=0.1.0",
    "lucide-react": ">=0.400.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fuma-translate/react": "^1.0.2",
    "@types/node": "^26.4.1",
    "@types/react": "catalog:",
    "@types/react-file-icon": "^1.0.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "eslint": "catalog:",
    "lucide-react": "^1.39.0",
    "react": "catalog:",
    "shadcn": "^4.19.1",
    "tsc-alias": "^1.9.3",
    "tsup": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
